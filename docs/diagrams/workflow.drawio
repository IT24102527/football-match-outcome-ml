<mxfile host="app.diagrams.net"><diagram name="Workflow" id="workflow"><mxGraphModel dx="770" dy="975" grid="1" gridSize="10" page="1" pageWidth="770" pageHeight="975"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="problem" value="&lt;b&gt;Business problem:&lt;/b&gt; help a club&amp;#x27;s analytics and coaching staff prepare for upcoming matches&lt;br&gt;Primary lens: Match Outcome Prediction (H/D/A) · Supporting lens: Team Form &amp;amp; Home Advantage" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8A8A8A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="710" height="62" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;Data:&lt;/b&gt; European Soccer Database (SQLite) · 25,979 matches · 11 leagues · 2008/09–2015/16" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8A8A8A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="92" width="710" height="44" as="geometry"/></mxCell><mxCell id="repro" value="&lt;b&gt;Reproducibility:&lt;/b&gt; member branches → reviewed PRs → development → main&lt;br&gt;One clean run of notebooks 01–08 (D-031) · decision log D-001–D-031" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#8A8A8A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="905" width="710" height="52" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;1 · Data Understanding &amp;amp; EDA&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;color:#555555&#x27;&gt;Ahamed&lt;/i&gt;&lt;br&gt;• Tables, coverage, data-quality checks&lt;br&gt;• Target: 45.9% H · 25.4% D · 28.7% A&lt;br&gt;• Home advantage and form signal confirmed&lt;br&gt;&lt;b&gt;→ data dictionary, EDA insight log&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCE9F9;strokeColor=#2A78D6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="175" width="330" height="150" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;2 · Preprocessing &amp;amp; Target&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;color:#555555&#x27;&gt;Umair&lt;/i&gt;&lt;br&gt;• H/D/A target from full-time goals (D-004)&lt;br&gt;• Chronological sort by date and match ID&lt;br&gt;• Drop events, line-ups and odds (D-016)&lt;br&gt;&lt;b&gt;→ 03_preprocessing, src/preprocessing.py&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCE9F9;strokeColor=#2A78D6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="357" width="330" height="150" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;3 · Historical Features&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;color:#555555&#x27;&gt;Umair&lt;/i&gt;&lt;br&gt;• Form, goals for/against (last 5 matches)&lt;br&gt;• Venue win rates, form difference&lt;br&gt;• 2008/09 warm-up; train-median imputation&lt;br&gt;&lt;b&gt;→ features.csv (22,653 × 17)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCE9F9;strokeColor=#2A78D6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="539" width="330" height="150" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;4 · Leakage Prevention &amp;amp; Validation&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;color:#555555&#x27;&gt;Umair · Ahamed&lt;/i&gt;&lt;br&gt;• Only strictly earlier matches: shift(1)&lt;br&gt;• Manual spot-checks (D-020)&lt;br&gt;• Independent rebuild + leakage tests (04a)&lt;br&gt;&lt;b&gt;→ validated feature set&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCE9F9;strokeColor=#2A78D6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="721" width="330" height="150" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;5 · Train/Test Preparation&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;color:#555555&#x27;&gt;Yusuf&lt;/i&gt;&lt;br&gt;• Chronological split, no shuffling (D-021)&lt;br&gt;• Train 2009/10–2014/15: 19,327 matches&lt;br&gt;• Test 2015/16: 3,326 · tune on 2014/15&lt;br&gt;&lt;b&gt;→ one shared split for all models&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCE3D7;strokeColor=#EB6834;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="400" y="175" width="330" height="150" as="geometry"/></mxCell><mxCell id="p6" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;6 · Model Development&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;color:#555555&#x27;&gt;Yusuf&lt;/i&gt;&lt;br&gt;• Baseline, LR, Decision Tree, RF, KNN&lt;br&gt;• Balanced class weights (D-028)&lt;br&gt;• Hyperparameters tuned by macro F1&lt;br&gt;&lt;b&gt;→ 05_modeling, src/train_models.py&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCE3D7;strokeColor=#EB6834;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="400" y="357" width="330" height="150" as="geometry"/></mxCell><mxCell id="p7" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;7 · Model Evaluation&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;color:#555555&#x27;&gt;Yusuf&lt;/i&gt;&lt;br&gt;• Macro F1 primary; per-class metrics&lt;br&gt;• Draw recall and confusion matrices&lt;br&gt;• Accuracy by pre-match form gap&lt;br&gt;&lt;b&gt;→ model comparison table&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCE3D7;strokeColor=#EB6834;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="400" y="539" width="330" height="150" as="geometry"/></mxCell><mxCell id="p8" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;8 · Selection &amp;amp; Recommendations&lt;/b&gt;&lt;br&gt;&lt;i style=&#x27;color:#555555&#x27;&gt;Jassim · Ahamed&lt;/i&gt;&lt;br&gt;• Logistic Regression: macro F1 0.434&lt;br&gt;• vs baseline 0.203 (D-029)&lt;br&gt;• Permutation importance → recommendations&lt;br&gt;&lt;b&gt;→ final report&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5F2E7;strokeColor=#1BAF7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="400" y="721" width="330" height="150" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=10;fontStyle=2;" edge="1" parent="1" source="data" target="p1"><mxGeometry relative="1" as="geometry"><mxPoint x="185" y="136" as="sourcePoint"/><mxPoint x="185" y="175" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=10;fontStyle=2;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"><mxPoint x="185.0" y="325" as="sourcePoint"/><mxPoint x="185.0" y="357" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=2;fontSize=10;fontStyle=2;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as=